# ── Email — provider 별 설정 (SendGrid / Resend / SMTP) ──────────
# Provider override (기본 'auto'). 운영자가 강제로 한 provider 만 쓰고 싶을 때:
#   auto      — SendGrid 우선 → Resend → SMTP → simulation (자동 분기)
#   sendgrid  — SendGrid 강제 (SENDGRID_API_KEY + SENDGRID_FROM 필요)
#   resend    — Resend 강제 (RESEND_API_KEY 필요, 도메인 인증 권장)
#   smtp      — SMTP 강제 (Render Free 는 outbound SMTP 차단으로 작동 X.
#               Cafe24 / 자체 서버에서만 동작)
#   none      — 강제 simulation (개발/디버그)
EMAIL_PROVIDER=auto

# ──────────────────────────────────────────
# Path A (현재 데모 권장) — SendGrid Web API (HTTPS, Render Free 호환)
# 무료 100/일. Single Sender Verification 만으로 임의 수신자 발송 가능
# (도메인 인증 불필요).
#   - SENDGRID_API_KEY: SendGrid 콘솔 → Settings → API Keys → "Mail Send"
#     권한으로 발급 ('SG.' prefix). 한 번만 표시되므로 즉시 안전 보관.
#   - SENDGRID_FROM   : Single Sender Verification 통과한 sender 이메일.
#   - SENDGRID_FROM_NAME: 받는 사람 inbox 의 발신자 표시 이름 (default 'DAEMU').
#     예: "DAEMU 베이커리·카페 컨설팅" 으로 두면 inbox 에 브랜드명 prominent.
#   - SENDGRID_API_URL : (선택) 기본 https://api.sendgrid.com/v3/mail/send
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=DAEMU 베이커리·카페 컨설팅

# ──────────────────────────────────────────
# Path B (운영 — 클라이언트 도메인 결정 후 권장) — Resend
# https://resend.com — 무료 100/일 / 3000/월. 도메인 인증 후 임의 수신자 발송.
# 도메인 미인증 시 onboarding@resend.dev 만 가능 (본인 등록 이메일에만 발송).
# 운영 클라이언트 도메인 인증 후 권장 설정:
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
#   FROM_EMAIL=DAEMU <noreply@<verified-domain>>
RESEND_API_KEY=
FROM_EMAIL=DAEMU <onboarding@resend.dev>

# ──────────────────────────────────────────
# Path C (운영 — 자체 메일 서버 / Cafe24) — SMTP
# Render Free 에선 outbound SMTP port (25/465/587) 차단으로 작동 X.
# Cafe24 / 자체 서버 / Gmail SMTP (앱 비밀번호) 등에서 사용:
#   EMAIL_PROVIDER=smtp
#   SMTP_HOST=<server smtp host>
#   SMTP_PORT=587 (STARTTLS, SMTP_USE_TLS=1) 또는 465 (SSL, SMTP_USE_TLS=0)
#   SMTP_USER=<smtp user>
#   SMTP_PASS=<smtp password / Gmail 앱 비밀번호>
#   SMTP_FROM=DAEMU <mail@client-domain>
# Gmail SMTP: 일반 비밀번호 X — Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호.
# Naver SMTP: smtp.naver.com:587, 메일 환경설정 → POP3/IMAP/SMTP 활성화 필요.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DAEMU <noreply@example.com>
SMTP_USE_TLS=1

# Database — default SQLite (file-based) for dev only.
# For production (Cafe24 / Aiven / managed MySQL):
#   DATABASE_URL=mysql+aiomysql://user:pass@host:3306/daemu
# (aiomysql 가 default driver — caching_sha2_password 호환성. asyncmy 도 가능
#  하면 MYSQL_DRIVER=asyncmy 환경변수로 swap.)
DATABASE_URL=sqlite+aiosqlite:///./daemu.db

# Auth — JWT secret + first-boot account seed.
# prod 에서:
#   - JWT_SECRET / DATABASE_URL 미설정 → 부팅 거부 (fail-closed).
#   - ADMIN_PASSWORD / TESTER_PASSWORD / DEVELOPER_PASSWORD 모두 옵션.
#     · 미설정 → 해당 계정 자동 seed 안 함 (기존 DB row 는 보존).
#     · 명시 set + 약한 default 값 ('daemu1234'/'tester1234'/'dev1234'/
#       'admin1234'/'1234'/'password') → 부팅 거부.
#     · 명시 set + 강한 값 → seed (DB 사용자 0명일 때만).
#   - admin 계정이 DB 에 0명인 채로 부팅하면 admin 로그인 불가 →
#     ADMIN_PASSWORD env 설정 후 재시작 또는 manage.py CLI 로 별도 생성.
# dev 에선 *_PASSWORD 미설정 시 default 값으로 seed (force_change=true).
JWT_SECRET=
ADMIN_EMAIL=admin@daemu.kr
# ADMIN_PASSWORD=  # prod 에서 admin 자동 seed 가 필요하면 강한 값으로 set (16자+)
TESTER_EMAIL=tester@daemu.local
# TESTER_PASSWORD=  # prod 에서 사용하려면 강한 값으로 set
DEVELOPER_EMAIL=dev@daemu.local
# DEVELOPER_PASSWORD=  # prod 에서 사용하려면 강한 값으로 set
JWT_TTL_HOURS=12

# CORS
ALLOWED_ORIGINS=http://localhost:8765,http://localhost:5173,http://localhost:8766,https://juyoungjun.github.io

# Optional: forces upload URLs to use this base instead of detecting from request host
PUBLIC_BASE_URL=

PORT=3000
