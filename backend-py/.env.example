# ── Email — Resend / SMTP ────────────────────────────────────
# Provider override (기본 'auto'). 운영자가 강제로 한 provider 만 쓰고 싶을 때:
#   auto    — RESEND_API_KEY 우선 → SMTP_HOST → simulation (기존 자동 동작)
#   smtp    — SMTP 강제 (RESEND_API_KEY 가 set 이어도 무시) — Resend 도메인
#             미인증 상태에서 임의 수신자 발송 시연용
#   resend  — Resend 강제 (RESEND_API_KEY 미설정 시 simulation)
#   none    — 강제 simulation (개발/디버그)
EMAIL_PROVIDER=auto

# Resend (https://resend.com) — 운영용. 도메인 인증 후 사용 권장.
# 도메인 미인증 + onboarding@resend.dev 발신 시 Resend test mode → 본 계정
# 등록 메일로만 발송 가능 (임의 수신자 차단). 임의 수신자 발송하려면 도메인
# 인증 필수 또는 EMAIL_PROVIDER=smtp 로 전환.
RESEND_API_KEY=
FROM_EMAIL=DAEMU <onboarding@resend.dev>

# SMTP (Gmail / Naver / 자체 메일 서버 등) — EMAIL_PROVIDER=smtp 또는
# RESEND_API_KEY 미설정 시 사용.
#   587 + STARTTLS  (SMTP_USE_TLS=1) — 일반적
#   465 + SSL       (SMTP_USE_TLS=0)
# Gmail SMTP: 일반 비밀번호 X — 앱 비밀번호 (Google 계정 → 보안 → 2단계 인증
# → 앱 비밀번호) 발급 후 SMTP_PASS 에 입력.
# Naver SMTP: smtp.naver.com:587, 메일 환경설정 → POP3/IMAP/SMTP 활성화 필요.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DAEMU <noreply@example.com>
SMTP_USE_TLS=1

# Database — default SQLite (file-based) for dev only.
# For production (Cafe24 / Aiven / managed MySQL):
#   DATABASE_URL=mysql+aiomysql://user:pass@host:3306/daemu
# (aiomysql 가 default driver — caching_sha2_password 호환성. asyncmy 도 가능
#  하면 MYSQL_DRIVER=asyncmy 환경변수로 swap.)
DATABASE_URL=sqlite+aiosqlite:///./daemu.db

# Auth — JWT secret + first-boot account seed.
# prod 에서:
#   - JWT_SECRET / DATABASE_URL 미설정 → 부팅 거부 (fail-closed).
#   - ADMIN_PASSWORD / TESTER_PASSWORD / DEVELOPER_PASSWORD 모두 옵션.
#     · 미설정 → 해당 계정 자동 seed 안 함 (기존 DB row 는 보존).
#     · 명시 set + 약한 default 값 ('daemu1234'/'tester1234'/'dev1234'/
#       'admin1234'/'1234'/'password') → 부팅 거부.
#     · 명시 set + 강한 값 → seed (DB 사용자 0명일 때만).
#   - admin 계정이 DB 에 0명인 채로 부팅하면 admin 로그인 불가 →
#     ADMIN_PASSWORD env 설정 후 재시작 또는 manage.py CLI 로 별도 생성.
# dev 에선 *_PASSWORD 미설정 시 default 값으로 seed (force_change=true).
JWT_SECRET=
ADMIN_EMAIL=admin@daemu.kr
# ADMIN_PASSWORD=  # prod 에서 admin 자동 seed 가 필요하면 강한 값으로 set (16자+)
TESTER_EMAIL=tester@daemu.local
# TESTER_PASSWORD=  # prod 에서 사용하려면 강한 값으로 set
DEVELOPER_EMAIL=dev@daemu.local
# DEVELOPER_PASSWORD=  # prod 에서 사용하려면 강한 값으로 set
JWT_TTL_HOURS=12

# CORS
ALLOWED_ORIGINS=http://localhost:8765,http://localhost:5173,http://localhost:8766,https://juyoungjun.github.io

# Optional: forces upload URLs to use this base instead of detecting from request host
PUBLIC_BASE_URL=

PORT=3000
